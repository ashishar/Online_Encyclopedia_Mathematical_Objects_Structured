{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oemo.org/schema/oemo-object.schema.json",
  "title": "OEMO Mathematical Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_code",
    "name",
    "notation",
    "type",
    "definition",
    "defining_equations",
    "visuals",
    "origin_history",
    "importance",
    "research_trends",
    "intuition",
    "minimal_example",
    "code_snippet",
    "connections",
    "variants",
    "core_properties",
    "level",
    "tags",
    "citations",
    "resources"
  ],
  "properties": {
    "object_code": { "type": "string", "pattern": "^[A-Z]{3}[0-9]{6}$" },
    "name": { "$ref": "#/$defs/cleanString" },
    "notation": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cleanString" }
    },
    "type": { "$ref": "#/$defs/cleanString" },
    "definition": { "$ref": "#/$defs/cleanString" },
    "defining_equations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["latex", "explanation"],
        "properties": {
          "latex": { "$ref": "#/$defs/cleanString" },
          "explanation": { "$ref": "#/$defs/cleanString" }
        }
      }
    },
    "visuals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "description", "image_url", "caption", "query"],
        "properties": {
          "type": { "$ref": "#/$defs/cleanString" },
          "description": { "$ref": "#/$defs/cleanString" },
          "image_url": { "type": "string" },
          "caption": { "$ref": "#/$defs/cleanString" },
          "query": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/cleanString" }
          }
        }
      }
    },
    "origin_history": { "$ref": "#/$defs/cleanString" },
    "importance": { "$ref": "#/$defs/cleanString" },
    "research_trends": { "$ref": "#/$defs/cleanString" },
    "intuition": { "$ref": "#/$defs/cleanString" },
    "minimal_example": { "$ref": "#/$defs/cleanString" },
    "code_snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "code"],
      "properties": {
        "language": { "$ref": "#/$defs/cleanString" },
        "code": { "$ref": "#/$defs/cleanString" }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to", "type"],
        "properties": {
          "to": { "$ref": "#/$defs/cleanString" },
          "type": { "$ref": "#/$defs/cleanString" }
        }
      }
    },
    "variants": {
      "type": "array",
      "items": { "$ref": "#/$defs/cleanString" }
    },
    "core_properties": {
      "type": "array",
      "items": { "$ref": "#/$defs/cleanString" }
    },
    "level": { "$ref": "#/$defs/cleanString" },
    "tags": {
      "type": "array",
      "items": { "$ref": "#/$defs/cleanString" }
    },
    "citations": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/linkItem" }
    },
    "resources": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/linkItem" }
    }
  },
  "$defs": {
    "cleanString": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [{ "pattern": "--" }, { "pattern": "\u2014\u2014" }]
      }
    },
    "linkItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "icon", "title"],
      "properties": {
        "type": { "$ref": "#/$defs/cleanString" },
        "icon": { "$ref": "#/$defs/cleanString" },
        "title": { "$ref": "#/$defs/cleanString" },
        "url": { "type": "string", "minLength": 1 }
      }
    }
  }
}
